# ---------------------------------------------------------------------------
# Base de données : PostgreSQL avec l'extension pgvector.
# Sur Railway, la variable DATABASE_URL est injectée automatiquement par le
# plugin Postgres. En local : docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg17
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serenite
DB_POOL_MIN=1
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Authentification. JWT_SECRET doit être long et aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
JWT_SECRET=changez-moi-absolument-en-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ---------------------------------------------------------------------------
# LLM. Anthropic est le moteur principal, OpenAI le fallback automatique.
# Si aucune clé n'est fournie, l'application bascule sur l'analyse
# déterministe locale (voir app/signals.py) et le dit explicitement.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2

# Embeddings : OpenAI text-embedding-3-large en 3072 dimensions.
# La colonne pgvector est un halfvec(3072) indexé en HNSW.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# ---------------------------------------------------------------------------
# Notifications push (Web Push / VAPID). Sans ces deux clés, le rappel quotidien
# retombe sur une minuterie dans la page — qui ne survit pas à la fermeture de
# l'application, et l'interface le dit.
#   Générer une paire : python -m app.vapid
# Ne la régénère pas une fois des appareils abonnés : ils seraient tous invalidés.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@exemple.fr

# Planificateur : rappel à l'heure locale de chacun, et dépôt du bilan
# hebdomadaire le dimanche soir. Un verrou consultatif Postgres évite les
# doublons si plusieurs répliques tournent.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# CORS : origines autorisées du frontend, séparées par des virgules.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ouvrir /auth/register (mettre false pour verrouiller l'instance après création du compte)
ALLOW_REGISTRATION=true

# ---------------------------------------------------------------------------
# Whoop (facultatif). Sans ces trois valeurs, l'intégration est simplement
# absente de l'interface : aucun bouton, aucune route qui échoue à moitié.
#
# À créer sur developer.whoop.com. L'URL de redirection doit correspondre
# **exactement** à celle déclarée là-bas, sinon l'échange de code est refusé
# sans message utile.
#
# Ce que cette source apporte : variabilité cardiaque et fréquence cardiaque de
# repos par nuit, sommeil mesuré, charge et fréquence maximale par séance.
# Ce qu'elle n'apporte pas : aucune série temporelle de fréquence cardiaque —
# détecter une crise de panique est donc hors de portée avec cette API.
# ---------------------------------------------------------------------------
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/integrations/whoop/callback
